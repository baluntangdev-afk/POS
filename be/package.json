{
  "name": "pos-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "npx prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "kill-port 3000",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:up": "docker compose up -d",
    "docker:dev": "docker compose up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build app",
    "docker:build:up": "docker compose build app && docker compose up -d",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop pos-backend",
    "pm2:restart": "pm2 restart pos-backend",
    "pm2:delete": "pm2 delete pos-backend",
    "pm2:logs": "pm2 logs pos-backend",
    "pm2:monit": "pm2 monit",
    "migration:generate": "node scripts/migration-generate.js",
    "migration:create": "node scripts/migration-create.js",
    "migration:up": "typeorm-ts-node-commonjs migration:run -d src/database/config/typeorm.config.ts",
    "migration:down": "typeorm-ts-node-commonjs migration:revert -d src/database/config/typeorm.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/config/typeorm.config.ts",
    "migration:sync-index": "node scripts/sync-migrations-index.js",
    "seed": "node scripts/seed.js",
    "seed:create": "node scripts/seed-create.js",
    "seed:run": "npx ts-node src/database/run-seeders-cli.ts",
    "db:reset": "node scripts/db-reset.js",
    "seed:sync-index": "node scripts/sync-seeders-index.js",
    "build:sea": "npm run migration:sync-index && npm run seed:sync-index && npm run build && ts-node -T build-exe.ts",
    "check:quotes": "powershell -NoProfile -ExecutionPolicy Bypass -File installer\\scripts\\check-smart-quotes.ps1",
    "fix:quotes": "powershell -NoProfile -ExecutionPolicy Bypass -File installer\\scripts\\fix-smart-quotes.ps1",
    "prepare": "git -C .. config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dayjs": "^1.11.19",
    "lodash": "^4.17.23",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@vercel/ncc": "^0.38.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "kill-port": "^2.0.1",
    "pm2": "^6.0.14",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
