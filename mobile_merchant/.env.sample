# Copy this file to `.env` and fill in the values before running the app.

# Base URL of the backend API (no trailing slash).
API_BASE_URL=http://10.0.2.2:3000/api/v1

# Display name of the app.
APP_NAME=DPO Merchant

# Enable verbose HTTP + app logging ("true" / "false").
ENABLE_LOGGING=true

# Password gating the in-app "custom API endpoint" settings dialog.
SETTINGS_PASSWORD=changeme
